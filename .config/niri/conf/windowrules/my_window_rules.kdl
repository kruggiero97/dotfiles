// Maximize these windows
window-rule {
  match app-id=r#"^(brave-browser|zen|vesktop|steam|eu.betterbird.Betterbird|librewolf)$"#
  open-maximized true
  open-maximized-to-edges false
}

// Float these dialogs
window-rule {
  match app-id=r#"^(org\.gnome\.Calculator)$"#
  open-floating true
  open-maximized-to-edges false
}

// Float volume control
window-rule {
  match app-id=r#"^(org\.pulseaudio\.pavucontrol)$"#
  open-floating true
  open-maximized-to-edges false
  default-column-width { fixed 900; }
  default-window-height { fixed 700; }
}

// Float Runelite
window-rule {
  match app-id=r#"^(net-runelite-client-RuneLite)$"#
  open-floating true
  open-maximized-to-edges false
  default-column-width { fixed 2200; }
  default-window-height { fixed 1369; }
  default-floating-position x=10 y=10 relative-to="top-left"
}

window-rule {
  match app-id=r#"^(bolt-launcher)$"#
  open-floating true
  open-maximized-to-edges false
  default-column-width { fixed 1300; }
  default-window-height { fixed 875; }
}
// test
// Browser Picture in Picture
window-rule {
  match title=r#"^Picture-in-Picture|Picture in picture$"#
  open-floating true
  default-column-width { fixed 480; }
  default-window-height { fixed 270; }
  default-floating-position x=17 y=55 relative-to="top-right"
}

// gsimplecal
window-rule {
  match app-id=r#"^gsimplecal$"#
  open-floating true
  default-floating-position x=13 y=5 relative-to="top-right"
}

// Steam Friends List
window-rule {
  match app-id=r#"^steam$"# title=r#"^Friends List$"#
  open-floating true
}

// Betterbird New Event/New Task
window-rule {
  match app-id=r#"^eu\.betterbird\.Betterbird$"# title=r#"^Edit Item$"#
  open-floating true
  default-column-width { fixed 900; }
  default-window-height { fixed 700; }
}

// Betterbird Reminders
window-rule {
  match app-id=r#"^eu\.betterbird\.Betterbird$"# title=r#"^Calendar Reminders$"#
  open-floating true
  default-column-width { fixed 600; }
  default-window-height { fixed 450; }
}

// Zen bookmarks
window-rule {
  match app-id=r#"^zen$"# title=r#"^Library$"#
  open-floating true
  default-column-width { fixed 1100; }
  default-window-height { fixed 800; }
}

// Open on specific workspace, exclude PiP
window-rule {
  match app-id=r#"^(brave-browser|zen|librewolf)$"#
  exclude title=r#"^Picture-in-Picture|Picture in picture$"#
  open-on-workspace "browser"
}

window-rule {
  match app-id=r#"^(vesktop)$"#
  open-on-workspace "social"
}

window-rule {
  match app-id=r#"^(steam|heroic|bolt-launcher|net-runelite-client-RuneLite)$"#
  open-on-workspace "game"
}

// Global window rules
window-rule {
  draw-border-with-background false
  geometry-corner-radius 12
  clip-to-geometry true
}

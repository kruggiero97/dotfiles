input {
  focus-follows-mouse max-scroll-amount="50%"
  warp-mouse-to-focus
  keyboard {
    xkb {
      layout "us,us"
      variant ",intl"
      options "grp:alt_shift_toggle"
    }

    numlock
  }

  touchpad {
    tap
    // natural-scroll   // uncomment to enable; omit to disable
    scroll-factor 1.0
  }

  mouse {
  }
}
